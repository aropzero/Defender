config_version=5

[application]

config/name="Citadel of Echoes"
config/description="A roguelite tower-defense where every tower and spell carries elemental essence; the interplay between them is the real weapon."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.06, 0.09, 1)
config/icon="res://icon.svg"

[autoload]

Meta="*res://scripts/meta/meta_store.gd"
DB="*res://scripts/db/content_db.gd"
